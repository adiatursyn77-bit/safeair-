// Скопируй этот файл в secrets.h (рядом с .ino) и впиши свои значения.
// secrets.h добавлен в .gitignore и в репозиторий не попадает.
#pragma once

#define WIFI_SSID      "your-wifi-name"
#define WIFI_PASSWORD  "your-wifi-password"

// Должен совпадать с ID документа devices/{DEVICE_ID} в Firestore.
#define DEVICE_ID      "esp8266-test-01"
// Секрет платы (минимум 8 символов). В Firestore хранится только его SHA-256.
#define DEVICE_SECRET  "change-me-to-a-long-secret"

// Адрес твоего Cloudflare Worker, без слэша на конце.
#define WORKER_URL     "https://your-worker.your-subdomain.workers.dev"
